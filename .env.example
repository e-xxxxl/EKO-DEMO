PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ekounitedfc?appName=EKOUNITEDFC
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string
# Set to "paystack" or "flutterwave" once you've filled in that provider's
# secret key below — checkout stays in "payments not configured" mode until
# both this and the matching secret key are set. Both adapters are fully
# implemented; only one needs to be active at a time.
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flutterwave dashboard > Settings > Webhooks — a secret string you choose
# there and paste here; Flutterwave echoes it back on every webhook call so
# we can confirm the request actually came from them.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Media accreditation requests (POST /api/media-accreditation) email
# Ekounitedfc01@gmail.com via Resend — until this key is set, that route
# returns a clear "not configured yet" response instead of silently
# dropping submissions. RESEND_FROM_EMAIL needs a domain verified in the
# Resend dashboard for real delivery; their shared sandbox address only
# delivers to the account owner's own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
